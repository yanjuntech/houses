.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 30rpx;
}

/* ===================== 收藏列表 ===================== */
.favorite-list {
  padding: 20rpx;
}

.favorite-card {
  background: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.card-content {
  display: flex;
}

.card-content:active {
  opacity: 0.92;
}

.house-cover {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f5f7fa;
}

.placeholder-icon {
  font-size: 56rpx;
  color: #c0c4cc;
}

.placeholder-text {
  font-size: 22rpx;
  color: #c0c4cc;
  margin-top: 8rpx;
}

.house-type-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(64, 128, 255, 0.9);
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.house-info {
  flex: 1;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.house-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666666;
  margin-top: 8rpx;
}

.meta-item {
  color: #666666;
}

.meta-divider {
  margin: 0 12rpx;
  color: #dddddd;
}

.house-community {
  margin-top: 8rpx;
}

.community-name {
  font-size: 24rpx;
  color: #4080ff;
}

.house-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.house-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #f56c6c;
}

.price-unit {
  font-size: 22rpx;
  color: #f56c6c;
  margin-left: 4rpx;
}

.favorite-time {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.time-icon {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.time-text {
  font-size: 22rpx;
  color: #999999;
}

/* ===================== 卡片底部操作区 ===================== */
.card-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.cancel-btn {
  padding: 10rpx 28rpx;
  border: 1rpx solid #f56c6c;
  color: #f56c6c;
  font-size: 24rpx;
  border-radius: 24rpx;
  line-height: 1.4;
}

.cancel-btn:active {
  opacity: 0.7;
  background: #fef0f0;
}

/* ===================== 空状态 ===================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 80rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: #c0c4cc;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  margin-top: 20rpx;
}

.empty-btn {
  margin-top: 30rpx;
  padding: 16rpx 48rpx;
  background: #f0f5ff;
  color: #4080ff;
  font-size: 26rpx;
  border-radius: 32rpx;
}

.empty-btn:active {
  opacity: 0.85;
}
