.page {
  min-height: 100vh;
  background-color: #FAF8F5;
  padding-bottom: 30rpx;
}

/* ===================== 收藏列表 ===================== */
.favorite-list {
  padding: 20rpx;
}

.favorite-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #EDE8E1;
  overflow: hidden;
}

.card-content {
  display: flex;
}

.card-content:active {
  opacity: 0.92;
}

.house-cover {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: #EDE8E1;
  border-radius: 8rpx;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F5F2EE;
}

.placeholder-icon {
  font-size: 56rpx;
  color: #A0A0A0;
}

.placeholder-text {
  font-size: 22rpx;
  color: #A0A0A0;
  margin-top: 8rpx;
}

.house-type-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: #C45B3F;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.house-info {
  flex: 1;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.house-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #6B6B6B;
  margin-top: 8rpx;
}

.meta-item {
  color: #6B6B6B;
}

.meta-divider {
  margin: 0 12rpx;
  color: #C4C0BA;
}

.house-community {
  margin-top: 8rpx;
}

.community-name {
  font-size: 24rpx;
  color: #C45B3F;
}

.house-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.house-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #C4453F;
}

.price-unit {
  font-size: 22rpx;
  color: #C4453F;
  margin-left: 4rpx;
}

.favorite-time {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.time-icon {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.time-text {
  font-size: 22rpx;
  color: #A0A0A0;
}

/* ===================== 卡片底部操作区 ===================== */
.card-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EDE8E1;
}

.cancel-btn {
  padding: 10rpx 28rpx;
  border: 1rpx solid #C4453F;
  color: #C4453F;
  font-size: 24rpx;
  border-radius: 24rpx;
  line-height: 1.4;
}

.cancel-btn:active {
  opacity: 0.7;
  background: #FDF0EB;
}

/* ===================== 空状态 ===================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 80rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: #A0A0A0;
}

.empty-text {
  font-size: 28rpx;
  color: #A0A0A0;
  margin-top: 20rpx;
}

.empty-btn {
  margin-top: 30rpx;
  padding: 16rpx 48rpx;
  background: #FDF0EB;
  color: #C45B3F;
  font-size: 26rpx;
  border-radius: 32rpx;
}

.empty-btn:active {
  opacity: 0.85;
}
