.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* ===================== 顶部配额展示卡片 ===================== */
.quota-card {
  margin: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.quota-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quota-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.quota-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.quota-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #4080ff;
  line-height: 1;
}

.quota-value-danger {
  color: #f56c6c;
}

.quota-unit {
  font-size: 24rpx;
  color: #999999;
  margin-left: 6rpx;
}

.quota-value-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.2;
}

/* 配额不足提示 */
.quota-warn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #fef0f0;
  border-radius: 8rpx;
}

.quota-warn-text {
  flex: 1;
  font-size: 26rpx;
  color: #f56c6c;
}

.quota-warn-btn {
  padding: 8rpx 24rpx;
  background: #f56c6c;
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 24rpx;
}

.quota-warn-btn:active {
  opacity: 0.85;
}

/* ===================== 表单卡片通用样式 ===================== */
.form-card {
  margin: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* ===================== 表单项 ===================== */
.form-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item-block {
  flex-direction: column;
  align-items: stretch;
}

.form-label {
  width: 200rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #333333;
}

.form-item-block .form-label {
  width: auto;
  margin-bottom: 16rpx;
}

.required {
  color: #f56c6c;
  margin-left: 4rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  text-align: right;
}

.form-item-block .form-input {
  text-align: left;
}

.input-placeholder {
  color: #999999;
  font-size: 28rpx;
}

/* 带单位输入框 */
.input-with-unit {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.input-with-unit .form-input {
  flex: 1;
  text-align: right;
}

.input-unit {
  font-size: 26rpx;
  color: #999999;
  margin-left: 12rpx;
}

/* picker 文本 */
.form-picker {
  flex: 1;
}

.picker-text {
  font-size: 28rpx;
  color: #333333;
  text-align: right;
}

.picker-text-active {
  color: #333333;
}

.picker-placeholder {
  color: #999999;
}

/* ===================== 图片选择区 ===================== */
.image-area {
  width: 100%;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.thumb-image {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 50%;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f5f7fa;
  border: 1rpx dashed #dcdfe6;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.image-add:active {
  background: #ebeef5;
}

.add-icon {
  font-size: 60rpx;
  color: #c0c4cc;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* ===================== 描述文本域 ===================== */
.form-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: #333333;
  background: #f5f7fa;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.textarea-count {
  text-align: right;
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* ===================== 底部固定操作栏 ===================== */
.bottom-placeholder {
  height: 140rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx;
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.publish-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, #4080ff 0%, #609cff 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

.publish-btn:active {
  opacity: 0.85;
}

.publish-btn-disabled {
  opacity: 0.6;
}
