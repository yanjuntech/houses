/* 房屋发布 — Warm Editorial */
.page {
  min-height: 100vh;
  background: #FAF8F5;
  padding-bottom: 40rpx;
}

/* ---- 配额卡片 ---- */
.quota-card {
  margin: 24rpx 32rpx;
  padding: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDE8E1;
  border-radius: 20rpx;
}

.quota-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quota-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.quota-label {
  font-size: 22rpx;
  color: #A0A0A0;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
  text-transform: uppercase;
}

.quota-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #C45B3F;
  line-height: 1;
}

.quota-value-danger {
  color: #C4453F;
}

.quota-unit {
  font-size: 24rpx;
  color: #A0A0A0;
  margin-left: 6rpx;
}

.quota-value-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.quota-warn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: #FDF0EB;
  border-radius: 12rpx;
}

.quota-warn-text {
  flex: 1;
  font-size: 24rpx;
  color: #C4453F;
}

.quota-warn-btn {
  padding: 8rpx 24rpx;
  background: #C45B3F;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 8rpx;
}

.quota-warn-btn:active {
  opacity: 0.82;
}

/* ---- 表单卡片 ---- */
.form-card {
  margin: 0 32rpx 24rpx;
  padding: 8rpx 28rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDE8E1;
  border-radius: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 1rpx;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #EDE8E1;
}

/* ---- 表单项 ---- */
.form-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F2EE;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item-block {
  flex-direction: column;
  align-items: stretch;
}

.form-label {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.form-item-block .form-label {
  width: auto;
  margin-bottom: 16rpx;
}

.required {
  color: #C4453F;
  margin-left: 4rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  text-align: right;
}

.form-item-block .form-input {
  text-align: left;
}

.input-placeholder {
  color: #C4C0BA;
  font-size: 28rpx;
}

/* 带单位 */
.input-with-unit {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.input-with-unit .form-input {
  flex: 1;
  text-align: right;
}

.input-unit {
  font-size: 24rpx;
  color: #A0A0A0;
  margin-left: 12rpx;
}

/* picker */
.form-picker {
  flex: 1;
}

.picker-text {
  font-size: 28rpx;
  color: #1A1A1A;
  text-align: right;
}

.picker-text-active {
  color: #1A1A1A;
}

.picker-placeholder {
  color: #C4C0BA;
}

/* ---- 图片选择区 ---- */
.image-area {
  width: 100%;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.thumb-image {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 50%;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FAF8F5;
  border: 2rpx dashed #EDE8E1;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.image-add:active {
  background: #F5F0EB;
}

.add-icon {
  font-size: 56rpx;
  color: #C4C0BA;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #A0A0A0;
  margin-top: 8rpx;
}

/* ---- 描述文本域 ---- */
.form-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  background: #FAF8F5;
  border-radius: 12rpx;
}

.textarea-count {
  text-align: right;
  font-size: 22rpx;
  color: #A0A0A0;
  margin-top: 8rpx;
}

/* ---- 底部操作栏 ---- */
.bottom-placeholder {
  height: 140rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #EDE8E1;
  z-index: 100;
}

.publish-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #C45B3F;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  border-radius: 16rpx;
}

.publish-btn:active {
  opacity: 0.82;
}

.publish-btn-disabled {
  opacity: 0.5;
}
