<view class="page">
  <!-- ===================== 顶部配额展示卡片 ===================== -->
  <view class="quota-card">
    <view class="quota-row">
      <view class="quota-item">
        <text class="quota-label">剩余发布次数</text>
        <text class="quota-value {{quotaInsufficient ? 'quota-value-danger' : ''}}">{{quotaCount}}</text>
        <text class="quota-unit">次</text>
      </view>
      <view class="quota-item">
        <text class="quota-label">有效期截止</text>
        <text class="quota-value-text">{{quotaExpireText || '加载中'}}</text>
      </view>
    </view>
    <!-- 配额不足提示 -->
    <view class="quota-warn" wx:if="{{quotaLoaded && quotaInsufficient}}">
      <text class="quota-warn-text">发布次数不足，请前往商城兑换</text>
      <view class="quota-warn-btn" bindtap="goMall">前往商城</view>
    </view>
  </view>

  <!-- ===================== 表单区域 ===================== -->
  <view class="form-card">
    <view class="card-title">房源信息</view>

    <!-- 小区选择 -->
    <view class="form-item">
      <view class="form-label">小区<text class="required">*</text></view>
      <picker
        class="form-picker"
        mode="selector"
        range="{{communityOptions}}"
        range-key="communityName"
        value="{{communityIndex}}"
        bindchange="onCommunityChange"
      >
        <view class="picker-text {{communityIndex > 0 ? 'picker-text-active' : 'picker-placeholder'}}">
          {{communityOptions[communityIndex].communityName || '请选择小区'}}
        </view>
      </picker>
    </view>

    <!-- 房屋标题 -->
    <view class="form-item">
      <view class="form-label">房屋标题<text class="required">*</text></view>
      <input
        class="form-input"
        type="text"
        maxlength="30"
        placeholder="请输入房屋标题（最多30字）"
        placeholder-class="input-placeholder"
        value="{{form.houseTitle}}"
        data-field="houseTitle"
        bindinput="onInput"
      />
    </view>

    <!-- 房屋类型 -->
    <view class="form-item">
      <view class="form-label">房屋类型<text class="required">*</text></view>
      <picker
        class="form-picker"
        mode="selector"
        range="{{houseTypeOptions}}"
        value="{{houseTypeIndex}}"
        bindchange="onHouseTypeChange"
      >
        <view class="picker-text {{houseTypeIndex >= 0 ? 'picker-text-active' : 'picker-placeholder'}}">
          {{houseTypeIndex >= 0 ? houseTypeOptions[houseTypeIndex] : '请选择类型'}}
        </view>
      </picker>
    </view>

    <!-- 户型描述 -->
    <view class="form-item">
      <view class="form-label">户型描述</view>
      <input
        class="form-input"
        type="text"
        placeholder="如：3室2厅2卫"
        placeholder-class="input-placeholder"
        value="{{form.houseLayout}}"
        data-field="houseLayout"
        bindinput="onInput"
      />
    </view>

    <!-- 房屋面积 -->
    <view class="form-item">
      <view class="form-label">房屋面积<text class="required">*</text></view>
      <view class="input-with-unit">
        <input
          class="form-input"
          type="digit"
          placeholder="请输入面积"
          placeholder-class="input-placeholder"
          value="{{form.houseArea}}"
          data-field="houseArea"
          bindinput="onInput"
        />
        <text class="input-unit">㎡</text>
      </view>
    </view>

    <!-- 月租金 -->
    <view class="form-item">
      <view class="form-label">月租金<text class="required">*</text></view>
      <view class="input-with-unit">
        <input
          class="form-input"
          type="digit"
          placeholder="请输入租金"
          placeholder-class="input-placeholder"
          value="{{form.housePrice}}"
          data-field="housePrice"
          bindinput="onInput"
        />
        <text class="input-unit">元/月</text>
      </view>
    </view>

    <!-- 楼层 -->
    <view class="form-item">
      <view class="form-label">楼层</view>
      <input
        class="form-input"
        type="text"
        placeholder="如：5/18"
        placeholder-class="input-placeholder"
        value="{{form.houseFloor}}"
        data-field="houseFloor"
        bindinput="onInput"
      />
    </view>

    <!-- 朝向 -->
    <view class="form-item">
      <view class="form-label">朝向</view>
      <picker
        class="form-picker"
        mode="selector"
        range="{{directionOptions}}"
        value="{{directionIndex}}"
        bindchange="onDirectionChange"
      >
        <view class="picker-text {{directionIndex >= 0 ? 'picker-text-active' : 'picker-placeholder'}}">
          {{directionIndex >= 0 ? directionOptions[directionIndex] : '请选择朝向'}}
        </view>
      </picker>
    </view>

    <!-- 装修 -->
    <view class="form-item">
      <view class="form-label">装修</view>
      <picker
        class="form-picker"
        mode="selector"
        range="{{decorationOptions}}"
        value="{{decorationIndex}}"
        bindchange="onDecorationChange"
      >
        <view class="picker-text {{decorationIndex >= 0 ? 'picker-text-active' : 'picker-placeholder'}}">
          {{decorationIndex >= 0 ? decorationOptions[decorationIndex] : '请选择装修'}}
        </view>
      </picker>
    </view>

    <!-- 房屋地址 -->
    <view class="form-item">
      <view class="form-label">房屋地址<text class="required">*</text></view>
      <input
        class="form-input"
        type="text"
        placeholder="请输入详细地址"
        placeholder-class="input-placeholder"
        value="{{form.houseAddress}}"
        data-field="houseAddress"
        bindinput="onInput"
      />
    </view>

    <!-- 房屋图片 -->
    <view class="form-item form-item-block">
      <view class="form-label">房屋图片</view>
      <view class="image-area">
        <view class="image-list">
          <view
            class="image-item"
            wx:for="{{imageList}}"
            wx:key="*this"
          >
            <image
              class="thumb-image"
              src="{{item}}"
              mode="aspectFill"
              data-url="{{item}}"
              bindtap="previewImage"
            />
            <view class="image-delete" data-index="{{index}}" catchtap="deleteImage">×</view>
          </view>
          <view class="image-add" wx:if="{{imageList.length < 9}}" bindtap="chooseImage">
            <text class="add-icon">+</text>
            <text class="add-text">{{imageList.length}}/9</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 房屋描述 -->
    <view class="form-item form-item-block">
      <view class="form-label">房屋描述</view>
      <textarea
        class="form-textarea"
        maxlength="500"
        placeholder="请输入房屋描述（最多500字）"
        placeholder-class="input-placeholder"
        value="{{form.houseDesc}}"
        data-field="houseDesc"
        bindinput="onInput"
      />
      <view class="textarea-count">{{form.houseDesc.length || 0}}/500</view>
    </view>
  </view>

  <!-- ===================== 联系信息 ===================== -->
  <view class="form-card">
    <view class="card-title">联系信息</view>

    <!-- 联系人姓名 -->
    <view class="form-item">
      <view class="form-label">联系人<text class="required">*</text></view>
      <input
        class="form-input"
        type="text"
        placeholder="请输入联系人姓名"
        placeholder-class="input-placeholder"
        value="{{form.contactName}}"
        data-field="contactName"
        bindinput="onInput"
      />
    </view>

    <!-- 联系电话 -->
    <view class="form-item">
      <view class="form-label">联系电话<text class="required">*</text></view>
      <input
        class="form-input"
        type="number"
        placeholder="请输入手机号"
        placeholder-class="input-placeholder"
        value="{{form.contactPhone}}"
        data-field="contactPhone"
        bindinput="onInput"
      />
    </view>
  </view>

  <!-- ===================== 底部占位（防止被固定栏遮挡） ===================== -->
  <view class="bottom-placeholder"></view>

  <!-- ===================== 底部固定操作栏 ===================== -->
  <view class="action-bar">
    <view class="publish-btn {{submitting ? 'publish-btn-disabled' : ''}}" bindtap="handleSubmit">
      {{submitting ? '发布中...' : '发布房源'}}
    </view>
  </view>
</view>
