.page {
  min-height: 100vh;
  background-color: #FAF8F5;
  padding-bottom: 40rpx;
}

/* ===================== 顶部图片轮播 ===================== */
.image-section {
  width: calc(100% - 40rpx);
  margin: 20rpx;
  height: 480rpx;
  background: #EDE8E1;
  border-radius: 20rpx;
  overflow: hidden;
}

.image-swiper {
  width: 100%;
  height: 100%;
}

.house-image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F5F2EE;
}

.placeholder-icon {
  font-size: 120rpx;
  color: #A0A0A0;
}

.placeholder-text {
  font-size: 28rpx;
  color: #A0A0A0;
  margin-top: 16rpx;
}

/* ===================== 信息卡片通用样式 ===================== */
.info-card {
  background: #FFFFFF;
  margin: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid #EDE8E1;
}

.base-info {
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
  border-radius: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #EDE8E1;
}

/* ===================== 基本信息 ===================== */
.house-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.price {
  font-size: 48rpx;
  font-weight: 700;
  color: #C4453F;
}

.price-unit {
  font-size: 24rpx;
  color: #C4453F;
  margin-left: 6rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  color: #C45B3F;
  background: #FDF0EB;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

/* ===================== 详细信息 ===================== */
.detail-item {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
}

.detail-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #A0A0A0;
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
}

.address-item {
  align-items: flex-start;
}

.address-value {
  line-height: 1.5;
}

/* ===================== 联系方式 ===================== */
.contact-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.contact-info {
  display: flex;
  align-items: center;
}

.contact-avatar {
  width: 80rpx;
  height: 80rpx;
  background: #FDF0EB;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.contact-text {
  display: flex;
  flex-direction: column;
}

.contact-name {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.contact-phone {
  font-size: 24rpx;
  color: #A0A0A0;
  margin-top: 6rpx;
}

.contact-call-btn {
  padding: 14rpx 32rpx;
  background: #FDF0EB;
  color: #C45B3F;
  font-size: 26rpx;
  border-radius: 32rpx;
}

.contact-call-btn:active {
  opacity: 0.85;
}

/* ===================== 底部操作栏 ===================== */
.bottom-placeholder {
  height: 120rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #EDE8E1;
  z-index: 100;
}

.action-favorite {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
  padding: 8rpx 0;
}

.favorite-icon {
  font-size: 40rpx;
}

.favorite-text {
  font-size: 22rpx;
  color: #6B6B6B;
  margin-top: 4rpx;
}

.action-favorite.favorited .favorite-text {
  color: #C45B3F;
}

.action-contact {
  flex: 1;
  margin-left: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #C45B3F;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 40rpx;
}

.action-contact:active {
  opacity: 0.85;
}

/* ===================== 加载中 ===================== */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-text {
  font-size: 28rpx;
  color: #A0A0A0;
}
