.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* ===================== 顶部图片轮播 ===================== */
.image-section {
  width: 100%;
  height: 480rpx;
  background: #f0f0f0;
}

.image-swiper {
  width: 100%;
  height: 100%;
}

.house-image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f5f7fa;
}

.placeholder-icon {
  font-size: 120rpx;
  color: #c0c4cc;
}

.placeholder-text {
  font-size: 28rpx;
  color: #c0c4cc;
  margin-top: 16rpx;
}

/* ===================== 信息卡片通用样式 ===================== */
.info-card {
  background: #ffffff;
  margin: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.base-info {
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
  border-radius: 24rpx 24rpx 16rpx 16rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* ===================== 基本信息 ===================== */
.house-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.price {
  font-size: 48rpx;
  font-weight: 700;
  color: #f56c6c;
}

.price-unit {
  font-size: 24rpx;
  color: #f56c6c;
  margin-left: 6rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  color: #4080ff;
  background: #f0f5ff;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

/* ===================== 详细信息 ===================== */
.detail-item {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
}

.detail-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #999999;
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.address-item {
  align-items: flex-start;
}

.address-value {
  line-height: 1.5;
}

/* ===================== 联系方式 ===================== */
.contact-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.contact-info {
  display: flex;
  align-items: center;
}

.contact-avatar {
  width: 80rpx;
  height: 80rpx;
  background: #f0f5ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.contact-text {
  display: flex;
  flex-direction: column;
}

.contact-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.contact-phone {
  font-size: 24rpx;
  color: #999999;
  margin-top: 6rpx;
}

.contact-call-btn {
  padding: 14rpx 32rpx;
  background: #f0f5ff;
  color: #4080ff;
  font-size: 26rpx;
  border-radius: 32rpx;
}

.contact-call-btn:active {
  opacity: 0.85;
}

/* ===================== 底部操作栏 ===================== */
.bottom-placeholder {
  height: 120rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-favorite {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
  padding: 8rpx 0;
}

.favorite-icon {
  font-size: 40rpx;
}

.favorite-text {
  font-size: 22rpx;
  color: #666666;
  margin-top: 4rpx;
}

.action-favorite.favorited .favorite-text {
  color: #f56c6c;
}

.action-contact {
  flex: 1;
  margin-left: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: linear-gradient(135deg, #4080ff 0%, #609cff 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 40rpx;
}

.action-contact:active {
  opacity: 0.85;
}

/* ===================== 加载中 ===================== */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}
