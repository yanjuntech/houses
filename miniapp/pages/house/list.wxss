.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 30rpx;
}

/* ===================== 搜索栏 ===================== */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #ffffff;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 14rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-placeholder {
  color: #999999;
  font-size: 28rpx;
}

.search-btn {
  margin-left: 20rpx;
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #4080ff 0%, #609cff 100%);
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 32rpx;
}

.search-btn:active {
  opacity: 0.85;
}

/* ===================== 筛选区域 ===================== */
.filter-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-item {
  flex: 1;
  margin-right: 16rpx;
}

.filter-text {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 8rpx;
  background: #f5f5f5;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #666666;
}

.filter-text-active {
  color: #4080ff;
  background: #f0f5ff;
}

.filter-arrow {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #999999;
}

.filter-reset {
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #999999;
}

.filter-reset:active {
  color: #4080ff;
}

/* ===================== 房源列表 ===================== */
.house-list {
  padding: 20rpx;
}

.house-card {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.house-card:active {
  opacity: 0.92;
}

.house-cover {
  position: relative;
  width: 240rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f5f7fa;
}

.placeholder-icon {
  font-size: 56rpx;
  color: #c0c4cc;
}

.placeholder-text {
  font-size: 22rpx;
  color: #c0c4cc;
  margin-top: 8rpx;
}

.house-type-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(64, 128, 255, 0.9);
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.house-info {
  flex: 1;
  padding: 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.house-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.house-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #f56c6c;
}

.price-unit {
  font-size: 22rpx;
  color: #f56c6c;
  margin-left: 4rpx;
}

.house-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666666;
  margin-top: 8rpx;
}

.meta-item {
  color: #666666;
}

.meta-divider {
  margin: 0 12rpx;
  color: #dddddd;
}

.house-community {
  margin-top: 8rpx;
}

.community-name {
  font-size: 24rpx;
  color: #4080ff;
}

.house-address {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.address-icon {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.address-text {
  font-size: 22rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

/* ===================== 空状态 ===================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 80rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: #c0c4cc;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  margin-top: 20rpx;
}

.empty-btn {
  margin-top: 30rpx;
  padding: 16rpx 48rpx;
  background: #f0f5ff;
  color: #4080ff;
  font-size: 26rpx;
  border-radius: 32rpx;
}

/* ===================== 加载更多 ===================== */
.loadmore {
  text-align: center;
  padding: 30rpx 0;
}

.loadmore-text {
  font-size: 24rpx;
  color: #999999;
}

/* ===================== 发布浮动按钮 ===================== */
.publish-fab {
  position: fixed;
  right: 30rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 110rpx;
  height: 110rpx;
  background: linear-gradient(135deg, #4080ff 0%, #609cff 100%);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(64, 128, 255, 0.4);
  z-index: 100;
}

.publish-fab:active {
  opacity: 0.85;
}

.publish-fab-icon {
  font-size: 36rpx;
  color: #ffffff;
  line-height: 1;
}

.publish-fab-text {
  font-size: 20rpx;
  color: #ffffff;
  margin-top: 4rpx;
}
