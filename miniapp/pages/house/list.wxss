.page {
  min-height: 100vh;
  background-color: #FAF8F5;
  padding-bottom: 30rpx;
}

/* ===================== 搜索栏 ===================== */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #EDE8E1;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #FAF8F5;
  border-radius: 32rpx;
  padding: 14rpx 24rpx;
  border: 1rpx solid #EDE8E1;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: #A0A0A0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
}

.search-placeholder {
  color: #A0A0A0;
  font-size: 28rpx;
}

.search-btn {
  margin-left: 20rpx;
  padding: 12rpx 28rpx;
  background: #C45B3F;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 32rpx;
}

.search-btn:active {
  opacity: 0.85;
}

/* ===================== 筛选区域 ===================== */
.filter-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #EDE8E1;
}

.filter-item {
  flex: 1;
  margin-right: 16rpx;
}

.filter-text {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 8rpx;
  background: #FAF8F5;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #6B6B6B;
  border: 1rpx solid #EDE8E1;
}

.filter-text-active {
  color: #C45B3F;
  background: #FDF0EB;
  border-color: #C45B3F;
}

.filter-arrow {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #A0A0A0;
}

.filter-reset {
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #A0A0A0;
}

.filter-reset:active {
  color: #C45B3F;
}

/* ===================== 房源列表 ===================== */
.house-list {
  padding: 20rpx;
}

.house-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  border: 1rpx solid #EDE8E1;
}

.house-card:active {
  opacity: 0.92;
}

.house-cover {
  position: relative;
  width: 240rpx;
  height: 200rpx;
  flex-shrink: 0;
  background: #EDE8E1;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F5F2EE;
}

.placeholder-icon {
  font-size: 56rpx;
  color: #A0A0A0;
}

.placeholder-text {
  font-size: 22rpx;
  color: #A0A0A0;
  margin-top: 8rpx;
}

.house-type-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: #C45B3F;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.house-info {
  flex: 1;
  padding: 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.house-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.house-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #C4453F;
}

.price-unit {
  font-size: 22rpx;
  color: #C4453F;
  margin-left: 4rpx;
}

.house-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #6B6B6B;
  margin-top: 8rpx;
}

.meta-item {
  color: #6B6B6B;
}

.meta-divider {
  margin: 0 12rpx;
  color: #C4C0BA;
}

.house-community {
  margin-top: 8rpx;
}

.community-name {
  font-size: 24rpx;
  color: #C45B3F;
}

.house-address {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.address-icon {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.address-text {
  font-size: 22rpx;
  color: #A0A0A0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

/* ===================== 空状态 ===================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 80rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: #A0A0A0;
}

.empty-text {
  font-size: 28rpx;
  color: #A0A0A0;
  margin-top: 20rpx;
}

.empty-btn {
  margin-top: 30rpx;
  padding: 16rpx 48rpx;
  background: #FDF0EB;
  color: #C45B3F;
  font-size: 26rpx;
  border-radius: 32rpx;
}

/* ===================== 加载更多 ===================== */
.loadmore {
  text-align: center;
  padding: 30rpx 0;
}

.loadmore-text {
  font-size: 24rpx;
  color: #A0A0A0;
}

/* ===================== 发布浮动按钮 ===================== */
.publish-fab {
  position: fixed;
  right: 30rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 110rpx;
  height: 110rpx;
  background: #C45B3F;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.publish-fab:active {
  opacity: 0.85;
}

.publish-fab-icon {
  font-size: 36rpx;
  color: #FFFFFF;
  line-height: 1;
}

.publish-fab-text {
  font-size: 20rpx;
  color: #FFFFFF;
  margin-top: 4rpx;
}
