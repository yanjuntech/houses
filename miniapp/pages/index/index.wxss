/* ===================== 首页 ===================== */
.page-index {
  min-height: 100vh;
  background: #FAF8F5;
}

/* ---- 顶部区域 ---- */
.hero {
  padding: 40rpx 32rpx 32rpx;
}

.hero-greeting {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.hero-greeting-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 1rpx;
}

.hero-subtitle {
  font-size: 24rpx;
  color: #A0A0A0;
  margin-top: 8rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #EDE8E1;
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
}

.search-icon {
  font-size: 30rpx;
  margin-right: 14rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: #C4C0BA;
}

/* ---- 轮播图 ---- */
.banner-section {
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}

.banner-swiper {
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #C45B3F 0%, #D9714E 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-placeholder-text {
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ---- 快捷入口 ---- */
.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 0 20rpx 40rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}

.action-item:active {
  opacity: 0.7;
}

.action-icon {
  width: 88rpx;
  height: 88rpx;
  background: #FDF0EB;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 12rpx;
}

.action-name {
  font-size: 22rpx;
  color: #6B6B6B;
  font-weight: 500;
}

/* ---- 区块通用 ---- */
.section {
  padding: 0 32rpx;
  margin-bottom: 48rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 1rpx;
}

.section-more {
  font-size: 24rpx;
  color: #C45B3F;
  font-weight: 500;
}

/* ---- 房源卡片 ---- */
.house-list {
  display: flex;
  flex-direction: column;
}

.house-card {
  background: #FFFFFF;
  border: 1rpx solid #EDE8E1;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-left: 6rpx solid #C45B3F;
}

.house-card:active {
  opacity: 0.85;
}

.house-info {
  display: flex;
  flex-direction: column;
}

.house-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.house-tag {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #C45B3F;
  border: 1rpx solid #C45B3F;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}

.house-community {
  font-size: 24rpx;
  color: #6B6B6B;
  margin-bottom: 12rpx;
}

.house-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #C4453F;
}

/* ---- 商家列表 ---- */
.merchant-list {
  display: flex;
  flex-direction: column;
}

.merchant-item {
  background: #FFFFFF;
  border: 1rpx solid #EDE8E1;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.merchant-item:active {
  opacity: 0.85;
}

.merchant-info {
  display: flex;
  flex-direction: column;
}

.merchant-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.merchant-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.merchant-category {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #D4943B;
  border: 1rpx solid #D4943B;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.merchant-address {
  font-size: 24rpx;
  color: #6B6B6B;
  margin-bottom: 12rpx;
}

.merchant-phone-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.merchant-phone {
  font-size: 26rpx;
  color: #C45B3F;
}

.merchant-call-btn {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #C45B3F;
  padding: 8rpx 28rpx;
  border-radius: 8rpx;
}

.merchant-call-btn:active {
  opacity: 0.82;
}

/* ---- 空状态 ---- */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #A0A0A0;
}

/* ---- 社区公告 ---- */
.notice-card {
  background: #FFFFFF;
  border: 1rpx solid #EDE8E1;
  border-radius: 20rpx;
  padding: 32rpx;
}

.notice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 16rpx;
  display: block;
}

.notice-desc {
  font-size: 26rpx;
  color: #6B6B6B;
  line-height: 1.7;
}
