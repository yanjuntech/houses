.header {
  position: relative;
  padding-top: 40rpx;
  padding-bottom: 60rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background: linear-gradient(135deg, #4080ff 0%, #609cff 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 0 30rpx;
}

.greeting {
  margin-bottom: 30rpx;
}

.greeting-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

.search-bar {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #999999;
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  background: #ffffff;
  margin: -30rpx 20rpx 20rpx;
  padding: 30rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 2;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  background: #f0f5ff;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.action-name {
  font-size: 24rpx;
  color: #333333;
}

.section {
  padding: 0 20rpx;
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-more {
  font-size: 26rpx;
  color: #999999;
}

.service-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.service-card {
  width: calc(50% - 10rpx);
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.service-image {
  width: 100%;
  height: 180rpx;
}

.service-info {
  padding: 20rpx;
}

.service-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
  display: block;
}

.service-desc {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 12rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 20rpx;
  color: #4080ff;
  background: #f0f5ff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
  margin-bottom: 4rpx;
}

.news-list {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.news-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.news-item:last-child {
  border-bottom: none;
}

.news-content {
  flex: 1;
}

.news-title {
  font-size: 28rpx;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.news-time {
  font-size: 24rpx;
  color: #999999;
}

.news-arrow {
  width: 32rpx;
  height: 32rpx;
  margin-left: 20rpx;
}

/* ============ 轮播图 ============ */
.banner-wrap {
  padding: 0 20rpx;
  margin-bottom: 30rpx;
}

.banner-swiper {
  width: 100%;
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

/* ============ 热门房源 ============ */
.house-list {
  display: flex;
  flex-direction: column;
}

.house-card {
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  border-left: 6rpx solid #4080ff;
}

.house-info {
  display: flex;
  flex-direction: column;
}

.house-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.house-tag {
  font-size: 22rpx;
  color: #4080ff;
  background: #f0f5ff;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.house-community {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff4d4f;
}

/* ============ 商家推荐 ============ */
.merchant-list {
  display: flex;
  flex-direction: column;
}

.merchant-card {
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.merchant-info {
  display: flex;
  flex-direction: column;
}

.merchant-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.merchant-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.merchant-category {
  font-size: 22rpx;
  color: #ff8c1a;
  background: #fff5e6;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.merchant-address {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.merchant-phone-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.merchant-phone {
  font-size: 26rpx;
  color: #4080ff;
}

.merchant-call-btn {
  font-size: 24rpx;
  color: #ffffff;
  background: #4080ff;
  padding: 6rpx 24rpx;
  border-radius: 24rpx;
}

/* ============ 空状态 ============ */
.empty-state {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 60rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-text {
  font-size: 26rpx;
  color: #999999;
}

/* ============ 欢迎信息 ============ */
.welcome-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
}

.welcome-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.welcome-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}