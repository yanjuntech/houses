<view class="page-index">
  <!-- 顶部区域：问候语 + 搜索 -->
  <view class="hero">
    <view class="hero-greeting">
      <text class="hero-greeting-text">{{greeting}}，欢迎回来</text>
      <text class="hero-subtitle" wx:if="{{!isLoggedIn}}">登录后体验更多功能</text>
    </view>
    <view class="search-bar" bindtap="handleSearch">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索房源、服务</text>
    </view>
  </view>

  <!-- 轮播图 -->
  <view class="banner-section">
    <swiper
      class="banner-swiper"
      autoplay="{{true}}"
      interval="4000"
      duration="500"
      circular="{{true}}"
      indicator-dots="{{true}}"
      indicator-color="rgba(196,91,63,0.2)"
      indicator-active-color="#C45B3F">
      <swiper-item wx:for="{{banners}}" wx:key="bannerId" data-url="{{item.jumpUrl}}" bindtap="handleBannerTap">
        <image wx:if="{{item.image}}" class="banner-image" src="{{item.image}}" mode="aspectFill" />
        <view wx:else class="banner-placeholder">
          <text class="banner-placeholder-text">{{item.title}}</text>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-actions">
    <view class="action-item" wx:for="{{quickActions}}" wx:key="id" bindtap="handleAction" data-id="{{item.id}}">
      <view class="action-icon">{{item.icon}}</view>
      <text class="action-name">{{item.name}}</text>
    </view>
  </view>

  <!-- 热门房源 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">热门房源</text>
      <text class="section-more" bindtap="viewMoreHouses">查看更多 ›</text>
    </view>
    <view class="house-list" wx:if="{{houses.length > 0}}">
      <view
        class="house-card"
        wx:for="{{houses}}"
        wx:key="id"
        bindtap="handleService"
        data-id="{{item.id}}">
        <view class="house-info">
          <text class="house-title">{{item.title}}</text>
          <view class="house-tags">
            <text class="house-tag" wx:if="{{item.layout}}">{{item.layout}}</text>
            <text class="house-tag" wx:if="{{item.area}}">{{item.area}}㎡</text>
          </view>
          <text class="house-community" wx:if="{{item.communityName}}">📍 {{item.communityName}}</text>
          <text class="house-price" wx:if="{{item.price}}">¥{{item.price}}/月</text>
        </view>
      </view>
    </view>
    <view class="empty-state" wx:else>
      <text class="empty-text">暂无热门房源</text>
    </view>
  </view>

  <!-- 商家推荐 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">商家推荐</text>
      <text class="section-more" bindtap="viewMoreMerchants">查看更多 ›</text>
    </view>
    <view class="merchant-list" wx:if="{{merchants.length > 0}}">
      <view
        class="merchant-item"
        wx:for="{{merchants}}"
        wx:key="id"
        bindtap="handleMerchant"
        data-phone="{{item.phone}}">
        <view class="merchant-info">
          <view class="merchant-top">
            <text class="merchant-name">{{item.name}}</text>
            <text class="merchant-category" wx:if="{{item.category}}">{{item.category}}</text>
          </view>
          <text class="merchant-address" wx:if="{{item.address}}">📍 {{item.address}}</text>
          <view class="merchant-phone-row">
            <text class="merchant-phone">📞 {{item.phone}}</text>
            <text class="merchant-call-btn">拨打</text>
          </view>
        </view>
      </view>
    </view>
    <view class="empty-state" wx:else>
      <text class="empty-text">暂无推荐商家</text>
    </view>
  </view>

  <!-- 社区公告 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">社区公告</text>
    </view>
    <view class="notice-card">
      <text class="notice-title">欢迎使用社区租赁服务</text>
      <text class="notice-desc">我们致力于为您提供便捷的房屋租赁、维修服务和商家查询体验。如有任何问题，请通过「联系客服」与我们沟通，祝您生活愉快！</text>
    </view>
  </view>
</view>
