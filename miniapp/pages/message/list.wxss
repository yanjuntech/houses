/* 消息中心 - 消息列表页样式 */
.message-page {
  min-height: 100vh;
  background-color: #FAF8F5;
}

/* 顶部标签栏 */
.tab-bar {
  display: flex;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #EDE8E1;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #6B6B6B;
  position: relative;
}

.tab-item.active {
  color: #C45B3F;
  font-weight: 700;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #C45B3F;
  border-radius: 3rpx;
}

/* 未读数量徽标 */
.badge {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  margin-left: 6rpx;
  background-color: #C4453F;
  color: #FFFFFF;
  font-size: 20rpx;
  border-radius: 16rpx;
  text-align: center;
  vertical-align: middle;
}

/* 消息列表 */
.message-list {
  padding: 16rpx 24rpx;
}

.message-item {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  position: relative;
  border: 1rpx solid #EDE8E1;
}

/* 未读红点 */
.unread-dot {
  position: absolute;
  top: 20rpx;
  left: 16rpx;
  width: 16rpx;
  height: 16rpx;
  background-color: #C45B3F;
  border-radius: 50%;
}

.item-content {
  flex: 1;
  min-width: 0;
  padding-left: 16rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.item-title {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 460rpx;
}

.item-time {
  font-size: 22rpx;
  color: #A0A0A0;
  flex-shrink: 0;
}

.item-preview {
  font-size: 26rpx;
  color: #6B6B6B;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-arrow {
  font-size: 40rpx;
  color: #C4C0BA;
  margin-left: 16rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #A0A0A0;
}

/* 加载提示 */
.loading-tip {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #A0A0A0;
}
