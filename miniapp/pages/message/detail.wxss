/* 消息中心 - 消息详情页样式 */
.detail-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 加载中 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 200rpx 0;
  font-size: 28rpx;
  color: #999;
}

/* 详情卡片 */
.detail-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 消息标题 - 居中大字号 */
.detail-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #222;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

/* 发送时间和发送人信息 - 灰色小字 */
.detail-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

.meta-label {
  color: #aaa;
}

.meta-value {
  color: #666;
  margin-left: 8rpx;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background-color: #eee;
  margin: 0 0 32rpx 0;
}

/* 消息内容 */
.detail-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  word-break: break-all;
  white-space: pre-wrap;
  padding: 16rpx 0;
}

/* 附件或链接区域 */
.attachment-area {
  margin-top: 40rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #eee;
}

.attachment-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.attachment-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  background-color: #f7f9fc;
  border-radius: 8rpx;
}

.attachment-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.attachment-text {
  font-size: 28rpx;
  color: #4080ff;
  flex: 1;
}

/* 返回按钮 */
.back-btn {
  margin-top: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background-color: #4080ff;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 44rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
