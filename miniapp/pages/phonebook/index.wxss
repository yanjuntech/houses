/* 电话簿页面样式 */
.phonebook-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #FAF8F5;
  overflow: hidden;
}

/* 顶部搜索栏（跨左右两栏） */
.search-wrap {
  padding: 30rpx 30rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #EDE8E1;
  flex-shrink: 0;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #FAF8F5;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  border: 1rpx solid #EDE8E1;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 14rpx;
  color: #A0A0A0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  height: 44rpx;
  line-height: 44rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #A0A0A0;
}

.search-clear {
  font-size: 28rpx;
  color: #A0A0A0;
  padding: 0 10rpx;
}

/* 左右分栏内容容器 */
.content-wrap {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 左侧分类列表 */
.category-sidebar {
  width: 180rpx;
  height: 100%;
  background: #FAF8F5;
  flex-shrink: 0;
  box-sizing: border-box;
}

.category-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 12rpx;
  font-size: 24rpx;
  color: #6B6B6B;
  background: #FAF8F5;
  transition: all 0.2s ease;
  box-sizing: border-box;
  border-left: 6rpx solid transparent;
  border-bottom: 1rpx solid #EDE8E1;
}

.category-item.active {
  color: #C45B3F;
  background: #FFFFFF;
  font-weight: 600;
  border-left: 6rpx solid #C45B3F;
}

.category-label {
  font-size: 24rpx;
  line-height: 1.3;
  text-align: center;
}

.category-badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #C45B3F;
  background: #FDF0EB;
  border-radius: 16rpx;
  text-align: center;
  box-sizing: border-box;
}

.category-item.active .category-badge {
  color: #C45B3F;
  background: #FDF0EB;
}

/* 右侧商家列表 */
.merchant-list {
  flex: 1;
  height: 100%;
  padding: 20rpx;
  box-sizing: border-box;
  background: #FAF8F5;
}

.merchant-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #EDE8E1;
}

.merchant-card:active {
  opacity: 0.85;
}

.merchant-main {
  flex: 1;
  overflow: hidden;
}

.merchant-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.merchant-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.merchant-cat-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #C45B3F;
  background: #FDF0EB;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.merchant-info-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.info-label {
  font-size: 24rpx;
  margin-right: 8rpx;
  color: #A0A0A0;
}

.info-text {
  font-size: 26rpx;
  color: #6B6B6B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 拨打电话按钮 */
.call-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 110rpx;
  height: 110rpx;
  margin-left: 20rpx;
  background: #C45B3F;
  border-radius: 50%;
  flex-shrink: 0;
}

.call-btn:active {
  opacity: 0.85;
}

.call-icon {
  font-size: 36rpx;
  color: #FFFFFF;
  line-height: 1;
}

.call-text {
  font-size: 22rpx;
  color: #FFFFFF;
  margin-top: 4rpx;
}

/* 列表底部提示 */
.list-bottom-tip {
  text-align: center;
  font-size: 22rpx;
  color: #A0A0A0;
  padding: 20rpx 0 40rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0 80rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #A0A0A0;
  margin-bottom: 10rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #A0A0A0;
}

/* 右侧浮动申请收录按钮 */
.apply-fab {
  position: fixed;
  right: 30rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  background: #C45B3F;
  border-radius: 60rpx;
  z-index: 50;
}

.apply-fab:active {
  opacity: 0.85;
  transform: scale(0.96);
}

.apply-fab-icon {
  font-size: 40rpx;
  color: #FFFFFF;
  line-height: 1;
}

.apply-fab-text {
  font-size: 18rpx;
  color: #FFFFFF;
  margin-top: 4rpx;
}
