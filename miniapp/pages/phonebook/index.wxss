/* 电话簿页面样式 */
.phonebook-page {
  min-height: 100vh;
  padding-bottom: 140rpx;
  background-color: #f5f5f5;
}

/* 顶部搜索栏 */
.search-wrap {
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #4080ff 0%, #609cff 100%);
  padding-top: 30rpx;
  padding-bottom: 30rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 14rpx;
  color: #999999;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  height: 44rpx;
  line-height: 44rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #999999;
}

.search-clear {
  font-size: 28rpx;
  color: #cccccc;
  padding: 0 10rpx;
}

/* 分类标签横向滚动 */
.category-scroll {
  white-space: nowrap;
  background: #ffffff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.category-list {
  display: inline-flex;
  padding: 0 20rpx;
}

.category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666666;
  background: #f5f5f5;
  border-radius: 30rpx;
  transition: all 0.2s ease;
}

.category-item.active {
  color: #ffffff;
  background: linear-gradient(135deg, #4080ff 0%, #609cff 100%);
  font-weight: 500;
}

/* 商家列表 */
.merchant-list {
  padding: 20rpx;
}

.merchant-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.merchant-card:active {
  opacity: 0.85;
}

.merchant-main {
  flex: 1;
  overflow: hidden;
}

.merchant-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.merchant-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.merchant-cat-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #4080ff;
  background: #f0f5ff;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.merchant-info-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.info-label {
  font-size: 24rpx;
  margin-right: 8rpx;
  color: #999999;
}

.info-text {
  font-size: 26rpx;
  color: #666666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 拨打电话按钮 */
.call-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 110rpx;
  height: 110rpx;
  margin-left: 20rpx;
  background: linear-gradient(135deg, #4080ff 0%, #609cff 100%);
  border-radius: 50%;
  flex-shrink: 0;
}

.call-btn:active {
  opacity: 0.85;
}

.call-icon {
  font-size: 36rpx;
  color: #ffffff;
  line-height: 1;
}

.call-text {
  font-size: 22rpx;
  color: #ffffff;
  margin-top: 4rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0 80rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999999;
  margin-bottom: 10rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #bbbbbb;
}

/* 底部申请收录按钮 */
.apply-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 10;
}

.apply-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: linear-gradient(135deg, #4080ff 0%, #609cff 100%);
  border-radius: 44rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
}

.apply-btn:active {
  opacity: 0.85;
}

.apply-icon {
  font-size: 34rpx;
  margin-right: 10rpx;
}

.apply-text {
  font-size: 30rpx;
}

/* 申请收录弹窗 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
}

.popup-content {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.popup-close {
  font-size: 36rpx;
  color: #999999;
  padding: 0 10rpx;
}

.popup-body {
  padding: 20rpx 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333333;
  background: #f5f5f5;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333333;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.picker-placeholder {
  color: #aaaaaa;
}

.picker-arrow {
  font-size: 32rpx;
  color: #cccccc;
}

.popup-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.popup-btn {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 30rpx;
}

.popup-btn.cancel {
  color: #999999;
  border-right: 1rpx solid #f0f0f0;
}

.popup-btn.confirm {
  color: #4080ff;
  font-weight: 500;
}

.popup-btn:active {
  background: #f5f5f5;
}
