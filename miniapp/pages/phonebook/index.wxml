<view class="phonebook-page">
  <!-- 顶部搜索栏（跨左右两栏） -->
  <view class="search-wrap">
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        type="text"
        placeholder="搜索商家名称"
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        bindinput="handleSearch"
        confirm-type="search"
      />
      <text wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword">✕</text>
    </view>
  </view>

  <!-- 左右分栏内容 -->
  <view class="content-wrap">
    <!-- 左侧分类列表 -->
    <scroll-view class="category-sidebar" scroll-y="true" enhanced="true" show-scrollbar="{{false}}">
      <view
        wx:for="{{categories}}"
        wx:key="value"
        class="category-item {{currentCategory === item.value ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="filterByCategory"
      >
        <text class="category-label">{{item.label}}</text>
        <text class="category-badge">{{item.count}}</text>
      </view>
    </scroll-view>

    <!-- 右侧商家列表 -->
    <scroll-view class="merchant-list" scroll-y="true" enhanced="true" show-scrollbar="{{false}}">
      <block wx:if="{{filteredMerchants.length > 0}}">
        <view
          class="merchant-card"
          wx:for="{{filteredMerchants}}"
          wx:key="id"
          data-phone="{{item.phone1 || item.phone || ''}}"
          bindtap="callPhone"
        >
          <view class="merchant-main">
            <view class="merchant-name-row">
              <text class="merchant-name">{{item.merchantName || item.merchant_name || item.name}}</text>
              <text class="merchant-cat-tag">{{categories[Number(item.category)] && categories[Number(item.category)].label || ''}}</text>
            </view>
            <view class="merchant-info-row" wx:if="{{item.address}}">
              <text class="info-label">📍</text>
              <text class="info-text">{{item.address}}</text>
            </view>
            <view class="merchant-info-row" wx:if="{{item.phone1 || item.phone}}">
              <text class="info-label">☎</text>
              <text class="info-text">{{item.phone1 || item.phone}}</text>
            </view>
            <view class="merchant-info-row" wx:if="{{item.phone2}}">
              <text class="info-label">☎</text>
              <text class="info-text">{{item.phone2}}</text>
            </view>
          </view>
          <view
            class="call-btn"
            catchtap="callPhone"
            data-phone="{{item.phone1 || item.phone || ''}}"
          >
            <text class="call-icon">📞</text>
            <text class="call-text">拨打</text>
          </view>
        </view>
        <view class="list-bottom-tip">没有更多了</view>
      </block>

      <!-- 空状态 -->
      <view class="empty-state" wx:else>
        <text class="empty-icon">📭</text>
        <text class="empty-text">暂无商家信息</text>
        <text class="empty-tip">您可以点击右下角"申请收录"添加商家</text>
      </view>
    </scroll-view>
  </view>

  <!-- 右侧浮动申请收录按钮 -->
  <view class="apply-fab" bindtap="handleApply">
    <text class="apply-fab-icon">＋</text>
    <text class="apply-fab-text">申请收录</text>
  </view>
</view>
