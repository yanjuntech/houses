<view class="container">
  <view class="user-header">
    <view class="header-bg"></view>
    <view class="user-info">
      <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill" />
      <view class="user-detail">
        <text class="nickname">{{userInfo.nickname}}</text>
        <text class="phone">{{userInfo.phone}}</text>
      </view>
      <view class="edit-btn" bindtap="handleEditProfile">
        <text class="edit-icon">✏️</text>
      </view>
    </view>
    <view class="user-stats">
      <view class="stat-item">
        <text class="stat-value">{{userStats.orders}}</text>
        <text class="stat-label">我的订单</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{userStats.coupons}}</text>
        <text class="stat-label">优惠券</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{userStats.points}}</text>
        <text class="stat-label">积分</text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" wx:for="{{menuList}}" wx:key="id" bindtap="handleMenu" data-id="{{item.id}}">
      <view class="menu-icon">{{item.icon}}</view>
      <text class="menu-text">{{item.text}}</text>
      <text class="menu-badge" wx:if="{{item.badge}}">{{item.badge}}</text>
      <image class="menu-arrow" src="data:image/png;base64," mode="aspectFit" />
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" wx:for="{{settingsList}}" wx:key="id" bindtap="handleSetting" data-id="{{item.id}}">
      <view class="menu-icon">{{item.icon}}</view>
      <text class="menu-text">{{item.text}}</text>
      <image class="menu-arrow" src="data:image/png;base64," mode="aspectFit" />
    </view>
  </view>

  <view class="footer">
    <text class="version">版本号：{{appVersion}}</text>
  </view>
</view>