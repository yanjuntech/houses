<view class="container">
  <view class="user-header">
    <view class="header-bg"></view>

    <!-- 已登录：显示用户信息 -->
    <view class="user-info" wx:if="{{isLoggedIn}}">
      <image class="avatar" src="{{userInfo.avatar || userInfo.wechatAvatar || defaultAvatar}}" mode="aspectFill" />
      <view class="user-detail">
        <view class="nickname-wrap">
          <text class="nickname">{{userInfo.nickname || userInfo.wechatNickname || '用户'}}</text>
          <text class="verify-tag {{userInfo.idCardVerified === 1 ? 'verified' : 'unverified'}}">{{userInfo.idCardVerified === 1 ? '已认证' : '未认证'}}</text>
        </view>
        <text class="phone" wx:if="{{maskedPhone}}">{{maskedPhone}}</text>
      </view>
      <view class="edit-btn" bindtap="handleEditProfile">
        <text class="edit-icon">✏️</text>
      </view>
    </view>

    <!-- 未登录：显示登录入口 -->
    <view class="user-info" wx:else>
      <image class="avatar" src="{{defaultAvatar}}" mode="aspectFill" />
      <view class="user-detail">
        <view class="login-btn" bindtap="handleLogin">请登录</view>
        <text class="login-tip">登录后享受更多服务</text>
      </view>
    </view>

    <!-- 数据统计：收藏、浏览、邀请 -->
    <view class="user-stats">
      <view class="stat-item" bindtap="handleMenu" data-id="2">
        <text class="stat-value">{{userStats.favorites}}</text>
        <text class="stat-label">我的收藏</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="handleMenu" data-id="3">
        <text class="stat-value">{{userStats.browses}}</text>
        <text class="stat-label">浏览记录</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="handleMenu" data-id="6">
        <text class="stat-value">{{userStats.inviteCount}}</text>
        <text class="stat-label">邀请人数</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" wx:for="{{menuList}}" wx:key="id" bindtap="handleMenu" data-id="{{item.id}}">
      <view class="menu-icon">{{item.icon}}</view>
      <text class="menu-text">{{item.text}}</text>
      <text class="menu-badge" wx:if="{{item.badge}}">{{item.badge}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 设置 -->
  <view class="menu-section">
    <view class="menu-item" wx:for="{{settingsList}}" wx:key="id" bindtap="handleSetting" data-id="{{item.id}}">
      <view class="menu-icon">{{item.icon}}</view>
      <text class="menu-text">{{item.text}}</text>
      <text class="menu-tag" wx:if="{{item.badge}}">{{item.badge}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <!-- 退出登录（仅登录时显示） -->
    <view class="menu-item logout-item" wx:if="{{isLoggedIn}}" bindtap="handleLogout">
      <view class="menu-icon">🚪</view>
      <text class="menu-text">退出登录</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="footer">
    <text class="version">版本号：{{appVersion}}</text>
  </view>
</view>
