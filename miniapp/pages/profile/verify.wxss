/* 实名认证页样式 */
.verify-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 已认证卡片 */
.verified-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20rpx;
}

.verified-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #67c23a;
  color: #ffffff;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.verified-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 40rpx;
}

.verified-info {
  width: 100%;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #999999;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
}

/* 表单卡片 */
.form-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-top: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  width: 160rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.input-placeholder {
  color: #c0c4cc;
}

/* 提交按钮 */
.btn-wrap {
  margin-top: 60rpx;
  padding: 0 30rpx;
}

.btn-submit {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 45rpx;
  background: linear-gradient(135deg, #4080ff 0%, #609cff 100%);
  color: #ffffff;
  font-size: 32rpx;
}

.btn-submit::after {
  border: none;
}

.btn-submit:active {
  opacity: 0.85;
}

/* 隐私提示文字 */
.tips {
  text-align: center;
  margin-top: 40rpx;
  padding: 0 40rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}
