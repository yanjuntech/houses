.user-header {
  position: relative;
  margin: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid #EDE8E1;
  border-radius: 20rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: transparent;
}

.user-info {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid #EDE8E1;
}

.user-detail {
  flex: 1;
  margin-left: 24rpx;
}

.nickname-wrap {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}

/* 实名认证状态标签 */
.verify-tag {
  margin-left: 16rpx;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  line-height: 1.4;
}

.verify-tag.verified {
  background: #EFF5EF;
  color: #5B8C5A;
}

.verify-tag.unverified {
  background: #FBF3E8;
  color: #D4943B;
}

.phone {
  font-size: 26rpx;
  color: #6B6B6B;
  display: block;
}

/* 未登录时的登录入口 */
.login-btn {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.login-tip {
  font-size: 24rpx;
  color: #6B6B6B;
  display: block;
  margin-top: 8rpx;
}

.edit-btn {
  width: 60rpx;
  height: 60rpx;
  background: #FAF8F5;
  border: 1rpx solid #EDE8E1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-icon {
  font-size: 28rpx;
  color: #6B6B6B;
}

.user-stats {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: #FFFFFF;
  margin: 0 20rpx;
  padding: 30rpx 0;
  border-radius: 20rpx;
  border: 1rpx solid #EDE8E1;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #A0A0A0;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #EDE8E1;
}

.menu-section {
  background: #FFFFFF;
  margin-top: 20rpx;
  border-top: 1rpx solid #EDE8E1;
  border-bottom: 1rpx solid #EDE8E1;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #EDE8E1;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
}

.menu-badge {
  font-size: 22rpx;
  color: #FFFFFF;
  background: #C4453F;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}

/* 设置项标签（如"已认证"） */
.menu-tag {
  font-size: 22rpx;
  color: #FFFFFF;
  background: #5B8C5A;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}

.menu-arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.4;
}

/* 退出登录项 */
.logout-item .menu-text {
  color: #C4453F;
}

.footer {
  padding: 60rpx 0;
  text-align: center;
}

.version {
  font-size: 24rpx;
  color: #A0A0A0;
}
