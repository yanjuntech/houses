<!-- 实名认证页 -->
<view class="verify-page">
  <!-- 已认证：显示已认证信息 -->
  <view class="verified-card" wx:if="{{verified}}">
    <view class="verified-icon">✓</view>
    <text class="verified-title">已完成实名认证</text>
    <view class="verified-info">
      <view class="info-row">
        <text class="info-label">真实姓名</text>
        <text class="info-value">{{maskedRealName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">身份证号</text>
        <text class="info-value">{{maskedIdCard}}</text>
      </view>
    </view>
  </view>

  <!-- 未认证：显示认证表单 -->
  <block wx:else>
    <view class="form-card">
      <view class="form-item">
        <text class="form-label">真实姓名</text>
        <input
          class="form-input"
          type="text"
          maxlength="10"
          placeholder="请输入真实姓名"
          placeholder-class="input-placeholder"
          value="{{realName}}"
          bindinput="onRealNameInput"
        />
      </view>
      <view class="form-item">
        <text class="form-label">身份证号</text>
        <input
          class="form-input"
          type="idcard"
          maxlength="18"
          placeholder="请输入身份证号"
          placeholder-class="input-placeholder"
          value="{{idCard}}"
          bindinput="onIdCardInput"
        />
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="btn-wrap">
      <button class="btn-submit" bindtap="handleSubmit">提交认证</button>
    </view>

    <!-- 隐私提示 -->
    <view class="tips">
      <text class="tips-text">实名信息仅用于身份验证，我们将严格保护您的隐私</text>
    </view>
  </block>
</view>
