.page {
  min-height: 100vh;
  background-color: #FAF8F5;
  padding-bottom: 40rpx;
}

/* ===================== 表单卡片 ===================== */
.form-card {
  background: #FFFFFF;
  margin: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid #EDE8E1;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #EDE8E1;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EDE8E1;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item-textarea {
  align-items: flex-start;
}

.form-label {
  width: 180rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  text-align: right;
}

.form-placeholder {
  color: #A0A0A0;
  font-size: 28rpx;
}

.form-textarea {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  min-height: 120rpx;
  padding: 8rpx 0;
  line-height: 1.6;
  box-sizing: border-box;
}

.form-picker {
  flex: 1;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 28rpx;
  color: #1A1A1A;
}

.picker-arrow {
  margin-left: 8rpx;
  color: #C4C0BA;
  font-size: 32rpx;
}

/* ===================== 提示卡片 ===================== */
.tips-card {
  display: flex;
  align-items: flex-start;
  background: #FDF0EB;
  margin: 0 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid #EDE8E1;
}

.tips-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.tips-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tips-text {
  font-size: 24rpx;
  color: #6B6B6B;
  line-height: 1.6;
}

/* ===================== 底部操作栏 ===================== */
.bottom-placeholder {
  height: 140rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #EDE8E1;
  z-index: 100;
}

.submit-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #C45B3F;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
}

.submit-btn:active {
  opacity: 0.85;
}

.submit-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ===================== 在租房屋选择卡片 ===================== */
.rental-card {
  background: #FFFFFF;
  margin: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid #EDE8E1;
}

.rental-list {
  display: flex;
  flex-direction: column;
}

.rental-item {
  position: relative;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  background: #FAF8F5;
  border: 1rpx solid #EDE8E1;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.rental-item:last-child {
  margin-bottom: 0;
}

.rental-item:active {
  background: #FDF0EB;
}

.rental-item-active {
  background: #FDF0EB;
  border-color: #C45B3F;
}

.rental-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #EDE8E1;
}

.rental-house-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rental-check {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #C45B3F;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.rental-item-row {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
}

.rental-item-label {
  width: 80rpx;
  font-size: 24rpx;
  color: #A0A0A0;
  flex-shrink: 0;
}

.rental-item-value {
  flex: 1;
  font-size: 26rpx;
  color: #6B6B6B;
  line-height: 1.5;
  word-break: break-all;
}

/* ===================== 空状态 ===================== */
.rental-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 20rpx;
}

.rental-empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.rental-empty-text {
  font-size: 26rpx;
  color: #A0A0A0;
  text-align: center;
  line-height: 1.6;
}
