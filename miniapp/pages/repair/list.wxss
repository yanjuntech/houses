.page {
  min-height: 100vh;
  background-color: #FAF8F5;
  padding-bottom: 30rpx;
}

/* ===================== 顶部 tab 栏 ===================== */
.tab-bar {
  display: flex;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #EDE8E1;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #6B6B6B;
  position: relative;
}

.tab-item.active {
  color: #C45B3F;
  font-weight: 700;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #C45B3F;
  border-radius: 3rpx;
}

/* ===================== 维修记录列表 ===================== */
.repair-list {
  padding: 20rpx 24rpx;
}

.repair-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #EDE8E1;
}

.repair-card:active {
  opacity: 0.92;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.repair-no {
  font-size: 24rpx;
  color: #A0A0A0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 16rpx;
}

/* 状态标签 */
.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.status-pending {
  color: #D4943B;
  background: #FBF3E8;
}

.status-processing {
  color: #C45B3F;
  background: #FDF0EB;
}

.status-done {
  color: #5B8C5A;
  background: #EFF5EF;
}

.status-cancelled {
  color: #A0A0A0;
  background: #F2F0EC;
}

/* 信息行 */
.card-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.row-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.row-text {
  flex: 1;
  font-size: 26rpx;
  color: #6B6B6B;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.desc-text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  white-space: normal;
}

/* 卡片底部 */
.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EDE8E1;
}

.create-time {
  font-size: 22rpx;
  color: #A0A0A0;
}

.arrow {
  font-size: 36rpx;
  color: #C4C0BA;
}

/* ===================== 空状态 ===================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  color: #A0A0A0;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #A0A0A0;
}

/* ===================== 加载更多 ===================== */
.loadmore {
  text-align: center;
  padding: 30rpx 0;
}

.loadmore-text {
  font-size: 24rpx;
  color: #A0A0A0;
}
