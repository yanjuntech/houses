<view class="page">
  <!-- 在租房屋选择 -->
  <view class="rental-card">
    <view class="card-title">选择维修房屋</view>

    <!-- 加载中 -->
    <view wx:if="{{rentalsLoading}}" class="rental-empty">
      <text class="rental-empty-text">加载中...</text>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{!hasRentals}}" class="rental-empty">
      <text class="rental-empty-icon">🏠</text>
      <text class="rental-empty-text">您当前无在租房屋，无法提交维修申请</text>
    </view>

    <!-- 在租房屋列表 -->
    <view wx:else class="rental-list">
      <view
        wx:for="{{rentals}}"
        wx:key="rentalId"
        class="rental-item {{selectedRentalId == item.rentalId ? 'rental-item-active' : ''}}"
        data-id="{{item.rentalId}}"
        bindtap="onSelectRental"
      >
        <view class="rental-item-header">
          <text class="rental-house-title">{{item.houseTitle || '未命名房屋'}}</text>
          <view wx:if="{{selectedRentalId == item.rentalId}}" class="rental-check">✓</view>
        </view>
        <view class="rental-item-row">
          <text class="rental-item-label">小区</text>
          <text class="rental-item-value">{{item.communityName || '-'}}</text>
        </view>
        <view class="rental-item-row">
          <text class="rental-item-label">地址</text>
          <text class="rental-item-value">{{item.houseAddress || '-'}}</text>
        </view>
        <view class="rental-item-row">
          <text class="rental-item-label">房东</text>
          <text class="rental-item-value">{{item.landlordName || '-'}} {{item.landlordPhone ? '· ' + item.landlordPhone : ''}}</text>
        </view>
        <view class="rental-item-row">
          <text class="rental-item-label">租期</text>
          <text class="rental-item-value">{{item.rentalStart || '-'}} ~ {{item.rentalEnd || '-'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="form-card">
    <view class="card-title">维修申请信息</view>

    <view class="form-item">
      <text class="form-label">联系人姓名</text>
      <input
        class="form-input"
        type="text"
        placeholder="请输入联系人姓名"
        placeholder-class="form-placeholder"
        value="{{form.contactName}}"
        bindinput="onContactNameInput"
      />
    </view>

    <view class="form-item">
      <text class="form-label">联系电话</text>
      <input
        class="form-input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        placeholder-class="form-placeholder"
        value="{{form.contactPhone}}"
        bindinput="onContactPhoneInput"
      />
    </view>

    <view class="form-item form-item-textarea">
      <text class="form-label">问题描述</text>
      <textarea
        class="form-textarea"
        placeholder="请详细描述需要维修的问题"
        placeholder-class="form-placeholder"
        value="{{form.description}}"
        bindinput="onDescriptionInput"
        maxlength="500"
        auto-height
      />
    </view>

    <view class="form-item">
      <text class="form-label">期望上门时间</text>
      <picker
        class="form-picker"
        mode="date"
        value="{{form.appointmentDate}}"
        start="{{today}}"
        bindchange="onDateChange"
      >
        <view class="picker-value">
          <text wx:if="{{form.appointmentDate}}">{{form.appointmentDate}}</text>
          <text wx:else class="form-placeholder">请选择日期</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>
  </view>

  <view class="tips-card">
    <text class="tips-icon">💡</text>
    <view class="tips-content">
      <text class="tips-text">提交后房东将尽快与您联系确认维修事宜。</text>
      <text class="tips-text">请保持电话畅通，并确保问题描述清晰准确。</text>
    </view>
  </view>

  <view class="bottom-placeholder"></view>
  <view class="action-bar">
    <view
      class="submit-btn {{submitting || !hasRentals || !selectedRentalId ? 'disabled' : ''}}"
      bindtap="handleSubmit"
    >
      {{submitting ? '提交中...' : '提交申请'}}
    </view>
  </view>
</view>
