.page {
  min-height: 100vh;
  background-color: #FAF8F5;
  padding-bottom: 40rpx;
}

/* ===================== 顶部状态卡片 ===================== */
.status-card {
  background: #FFFFFF;
  margin: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid #EDE8E1;
}

.status-info {
  background: #FAF8F5;
  border-radius: 20rpx;
  padding: 24rpx;
}

.status-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.status-label {
  font-size: 26rpx;
  color: #6B6B6B;
}

.status-no {
  font-size: 32rpx;
  color: #1A1A1A;
  font-weight: 700;
  word-break: break-all;
}

/* 状态标签 */
.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
}

.status-pending {
  color: #D4943B;
}

.status-processing {
  color: #C45B3F;
}

.status-done {
  color: #5B8C5A;
}

.status-cancelled {
  color: #A0A0A0;
}

/* ===================== 信息卡片通用样式 ===================== */
.info-card {
  background: #FFFFFF;
  margin: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid #EDE8E1;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #EDE8E1;
}

/* ===================== 详细信息 ===================== */
.detail-item {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
}

.detail-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #A0A0A0;
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
}

.detail-item-column {
  flex-direction: column;
}

.detail-item-column .detail-label {
  width: auto;
  margin-bottom: 8rpx;
}

.detail-desc {
  line-height: 1.6;
  color: #6B6B6B;
  background: #FAF8F5;
  padding: 16rpx;
  border-radius: 12rpx;
}

/* ===================== 时间线 ===================== */
.timeline {
  padding: 8rpx 0 0;
}

.timeline-item {
  display: flex;
  position: relative;
  padding-bottom: 32rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-left {
  width: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.timeline-node {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #EDE8E1;
}

/* 已完成节点 */
.timeline-item.done .timeline-node {
  background: #5B8C5A;
}

.node-check {
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: bold;
}

/* 当前节点 */
.timeline-item.current .timeline-node {
  background: #C45B3F;
  box-shadow: 0 0 0 8rpx rgba(196, 91, 63, 0.15);
}

.node-current {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

/* 待处理节点 */
.node-todo {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #C4C0BA;
}

/* 已取消节点 */
.timeline-item.cancelled .timeline-node {
  background: #EDE8E1;
}

/* 连接线 */
.timeline-line {
  flex: 1;
  width: 2rpx;
  background: #EDE8E1;
  margin: 4rpx 0;
  min-height: 32rpx;
}

.timeline-line.line-done {
  background: #5B8C5A;
}

/* 时间线内容 */
.timeline-content {
  flex: 1;
  padding-left: 16rpx;
  padding-top: 2rpx;
}

.timeline-title {
  font-size: 28rpx;
  color: #A0A0A0;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.timeline-title.title-done {
  color: #1A1A1A;
}

.timeline-title.title-current {
  color: #C45B3F;
  font-weight: 700;
}

.timeline-desc {
  font-size: 24rpx;
  color: #A0A0A0;
  line-height: 1.4;
}

/* 已取消提示 */
.cancelled-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.cancelled-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 50%;
  background: #EDE8E1;
  color: #A0A0A0;
  font-size: 40rpx;
  margin-bottom: 20rpx;
}

.cancelled-text {
  font-size: 28rpx;
  color: #A0A0A0;
}

/* ===================== 底部操作栏 ===================== */
.bottom-placeholder {
  height: 140rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #FFFFFF;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #EDE8E1;
  z-index: 100;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
}

.cancel-btn {
  background: #FAF8F5;
  color: #6B6B6B;
  border: 1rpx solid #EDE8E1;
}

.cancel-btn:active {
  opacity: 0.85;
}

.confirm-btn {
  background: #C45B3F;
  color: #FFFFFF;
}

.confirm-btn:active {
  opacity: 0.85;
}

/* ===================== 加载中 ===================== */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-text {
  font-size: 28rpx;
  color: #A0A0A0;
}
