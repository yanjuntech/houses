.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* ===================== 顶部状态卡片 ===================== */
.status-card {
  background: linear-gradient(135deg, #4080ff 0%, #609cff 100%);
  padding: 40rpx 24rpx 30rpx;
}

.status-info {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 24rpx;
}

.status-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.status-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.status-no {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 600;
  word-break: break-all;
}

/* 状态标签 */
.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.status-pending {
  color: #ff9500;
}

.status-processing {
  color: #4080ff;
}

.status-done {
  color: #4caf50;
}

.status-cancelled {
  color: #999999;
}

/* ===================== 信息卡片通用样式 ===================== */
.info-card {
  background: #ffffff;
  margin: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* ===================== 详细信息 ===================== */
.detail-item {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
}

.detail-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #999999;
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.detail-item-column {
  flex-direction: column;
}

.detail-item-column .detail-label {
  width: auto;
  margin-bottom: 8rpx;
}

.detail-desc {
  line-height: 1.6;
  color: #666666;
  background: #f9f9f9;
  padding: 16rpx;
  border-radius: 8rpx;
}

/* ===================== 时间线 ===================== */
.timeline {
  padding: 8rpx 0 0;
}

.timeline-item {
  display: flex;
  position: relative;
  padding-bottom: 32rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-left {
  width: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.timeline-node {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #f0f0f0;
}

/* 已完成节点 */
.timeline-item.done .timeline-node {
  background: #4caf50;
}

.node-check {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
}

/* 当前节点 */
.timeline-item.current .timeline-node {
  background: #4080ff;
  box-shadow: 0 0 0 8rpx rgba(64, 128, 255, 0.15);
}

.node-current {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ffffff;
}

/* 待处理节点 */
.node-todo {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #cccccc;
}

/* 已取消节点 */
.timeline-item.cancelled .timeline-node {
  background: #f0f0f0;
}

/* 连接线 */
.timeline-line {
  flex: 1;
  width: 2rpx;
  background: #e0e0e0;
  margin: 4rpx 0;
  min-height: 32rpx;
}

.timeline-line.line-done {
  background: #4caf50;
}

/* 时间线内容 */
.timeline-content {
  flex: 1;
  padding-left: 16rpx;
  padding-top: 2rpx;
}

.timeline-title {
  font-size: 28rpx;
  color: #999999;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.timeline-title.title-done {
  color: #333333;
}

.timeline-title.title-current {
  color: #4080ff;
  font-weight: 600;
}

.timeline-desc {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.4;
}

/* 已取消提示 */
.cancelled-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.cancelled-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 50%;
  background: #f0f0f0;
  color: #999999;
  font-size: 40rpx;
  margin-bottom: 20rpx;
}

.cancelled-text {
  font-size: 28rpx;
  color: #999999;
}

/* ===================== 底部操作栏 ===================== */
.bottom-placeholder {
  height: 140rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #ffffff;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666666;
}

.cancel-btn:active {
  opacity: 0.85;
}

.confirm-btn {
  background: linear-gradient(135deg, #4080ff 0%, #609cff 100%);
  color: #ffffff;
}

.confirm-btn:active {
  opacity: 0.85;
}

/* ===================== 加载中 ===================== */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}
