/* 登录页 — Warm Editorial */
.login-page {
  min-height: 100vh;
  background: #FAF8F5;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 56rpx;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 180rpx;
  margin-bottom: 80rpx;
}

.logo-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 32rpx;
  background: #FDF0EB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
}

.logo-title {
  margin-top: 32rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 4rpx;
}

.logo-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #A0A0A0;
  letter-spacing: 1rpx;
}

/* 登录卡片 */
.login-card {
  width: 100%;
  background: #FFFFFF;
  border: 1rpx solid #EDE8E1;
  border-radius: 24rpx;
  padding: 56rpx 44rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 36rpx;
}

.phone-input {
  width: 100%;
  height: 96rpx;
  border: none;
  border-bottom: 2rpx solid #EDE8E1;
  border-radius: 0;
  padding: 0 8rpx;
  font-size: 34rpx;
  color: #1A1A1A;
  background: transparent;
}

.phone-input:focus {
  border-color: #C45B3F;
}

.input-placeholder {
  color: #C4C0BA;
  font-size: 30rpx;
}

/* 手机号登录按钮 */
.btn-phone {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 16rpx;
  background: #C45B3F;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  border: none;
  margin-bottom: 36rpx;
}

.btn-phone::after {
  border: none;
}

.btn-phone:active {
  opacity: 0.82;
}

/* 分隔线 */
.divider {
  display: flex;
  align-items: center;
  margin: 16rpx 0 36rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #EDE8E1;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #C4C0BA;
}

/* 微信一键登录按钮 */
.btn-wechat {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 16rpx;
  background: #07C160;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-wechat::after {
  border: none;
}

.btn-wechat:active {
  opacity: 0.82;
}

.btn-wechat-icon {
  margin-right: 12rpx;
  font-size: 36rpx;
}

/* 错误提示 */
.error-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #C4453F;
}

.error-icon {
  margin-right: 8rpx;
}

/* 用户协议 */
.agreement {
  display: flex;
  align-items: flex-start;
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #A0A0A0;
  line-height: 1.6;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #C4C0BA;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 22rpx;
  margin-top: 4rpx;
}

.checkbox.checked {
  background: #C45B3F;
  border-color: #C45B3F;
}

.agreement-text {
  flex: 1;
}

.agreement-link {
  color: #C45B3F;
}
