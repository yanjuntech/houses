/* 登录页样式 */

/* 页面渐变背景 */
.login-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #4080ff 0%, #609cff 50%, #7ab8ff 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
  box-sizing: border-box;
}

/* Logo 区域 */
.logo-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 160rpx;
  margin-bottom: 80rpx;
}

.logo-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.logo-title {
  margin-top: 32rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.logo-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 登录卡片 */
.login-card {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 60rpx 48rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

/* 表单项 */
.form-item {
  margin-bottom: 40rpx;
}

/* 手机号输入框 */
.phone-input {
  width: 100%;
  height: 96rpx;
  border: 2rpx solid #e4e7ed;
  border-radius: 48rpx;
  padding: 0 36rpx;
  font-size: 32rpx;
  color: #333333;
  box-sizing: border-box;
  background: #f7f8fa;
}

.phone-input:focus {
  border-color: #4080ff;
  background: #ffffff;
}

.input-placeholder {
  color: #c0c4cc;
  font-size: 30rpx;
}

/* 手机号登录按钮（渐变色） */
.btn-phone {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #4080ff 0%, #609cff 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  margin-bottom: 40rpx;
}

.btn-phone::after {
  border: none;
}

.btn-phone:active {
  opacity: 0.85;
}

/* 分隔线 */
.divider {
  display: flex;
  align-items: center;
  margin: 20rpx 0 40rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e4e7ed;
}

.divider-text {
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #c0c4cc;
}

/* 微信一键登录按钮 */
.btn-wechat {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-wechat::after {
  border: none;
}

.btn-wechat:active {
  opacity: 0.85;
}

.btn-wechat-icon {
  margin-right: 12rpx;
  font-size: 36rpx;
}

/* 用户协议 */
.agreement {
  display: flex;
  align-items: flex-start;
  margin-top: 48rpx;
  font-size: 26rpx;
  color: #909399;
  line-height: 1.6;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #c0c4cc;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.checkbox.checked {
  background: #4080ff;
  border-color: #4080ff;
}

.agreement-text {
  flex: 1;
}

.agreement-link {
  color: #4080ff;
}
