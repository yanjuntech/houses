<!-- 登录页 -->
<view class="login-page">
  <!-- Logo 区域 -->
  <view class="logo-section">
    <view class="logo-icon">🏠</view>
    <view class="logo-title">社区租赁</view>
    <view class="logo-subtitle">您的智慧生活管家</view>
  </view>

  <!-- 登录卡片 -->
  <view class="login-card">
    <!-- 手机号登录表单 -->
    <view class="form-item">
      <input
        class="phone-input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        placeholder-class="input-placeholder"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <!-- 手机号登录按钮 -->
    <button class="btn-phone" bindtap="handlePhoneLogin" loading="{{loading}}">
      手机号登录
    </button>

    <!-- 分隔线 -->
    <view class="divider">
      <view class="divider-line"></view>
      <text class="divider-text">或</text>
      <view class="divider-line"></view>
    </view>

    <!-- 微信一键登录按钮 -->
    <button class="btn-wechat" bindtap="handleWechatLogin" loading="{{loading}}">
      <text class="btn-wechat-icon">💬</text>
      <text>微信一键登录</text>
    </button>

    <!-- 登录失败错误提示 -->
    <view wx:if="{{errorMsg}}" class="error-tip">
      <text class="error-icon">⚠</text>
      <text class="error-text">{{errorMsg}}</text>
    </view>

    <!-- 用户协议勾选 -->
    <view class="agreement">
      <view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="toggleAgreement">
        <text wx:if="{{agreed}}">✓</text>
      </view>
      <text class="agreement-text">
        我已阅读并同意
        <text class="agreement-link" bindtap="showUserAgreement">《用户协议》</text>
        和
        <text class="agreement-link" bindtap="showPrivacyPolicy">《隐私政策》</text>
      </text>
    </view>
  </view>
</view>
