/* 邀请管理页样式 */
.invite-page {
  min-height: 100vh;
  background-color: #FAF8F5;
  padding-bottom: 40rpx;
}

/* 顶部邀请统计卡片 */
.stats-card {
  margin: 20rpx;
  padding: 32rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 1rpx solid #EDE8E1;
}

.stats-header {
  display: flex;
  align-items: baseline;
  margin-bottom: 28rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-right: 16rpx;
}

.stats-subtitle {
  font-size: 24rpx;
  color: #A0A0A0;
}

.stats-body {
  display: flex;
  align-items: center;
  background: #FAF8F5;
  border-radius: 20rpx;
  padding: 24rpx 0;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #C45B3F;
  line-height: 1.1;
  margin-bottom: 8rpx;
}

.stats-value.verified {
  color: #C45B3F;
}

.stats-value.pending {
  color: #D4943B;
}

.stats-label {
  font-size: 24rpx;
  color: #A0A0A0;
}

.stats-divider {
  width: 1rpx;
  height: 80rpx;
  background: #EDE8E1;
}

/* 中部邀请操作区 */
.action-card {
  margin: 0 20rpx 20rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 1rpx solid #EDE8E1;
}

.invite-code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #EDE8E1;
}

.invite-code-label {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.invite-code-box {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: #FDF0EB;
  border-radius: 8rpx;
}

.invite-code-value {
  font-size: 30rpx;
  color: #C45B3F;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-right: 12rpx;
}

.copy-icon {
  font-size: 28rpx;
}

.action-buttons {
  display: flex;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 120rpx;
  border-radius: 20rpx;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1.2;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background: #C45B3F;
  color: #FFFFFF;
  margin-right: 16rpx;
}

.action-btn.secondary {
  background: #FDF0EB;
  color: #C45B3F;
  border: 1rpx solid #C45B3F;
}

.action-btn:active {
  opacity: 0.85;
}

.btn-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.btn-text {
  font-size: 26rpx;
  font-weight: 500;
}

/* 底部邀请列表 */
.list-section {
  margin: 0 20rpx;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 8rpx 20rpx;
}

.list-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.list-count {
  font-size: 24rpx;
  color: #A0A0A0;
}

.invite-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 0 24rpx;
  border: 1rpx solid #EDE8E1;
  overflow: hidden;
}

.invite-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #EDE8E1;
}

.invite-item:last-child {
  border-bottom: none;
}

.invite-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #EDE8E1;
  flex-shrink: 0;
}

.invite-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.invite-top {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.invite-nickname {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.status-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.status-tag.verified {
  color: #5B8C5A;
  background: #EFF5EF;
  border: 1rpx solid #5B8C5A;
}

.status-tag.unverified {
  color: #A0A0A0;
  background: #F2F0EC;
  border: 1rpx solid #EDE8E1;
}

.invite-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.invite-phone {
  font-size: 24rpx;
  color: #6B6B6B;
}

.invite-time {
  font-size: 22rpx;
  color: #A0A0A0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0 80rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #A0A0A0;
  margin-bottom: 10rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #A0A0A0;
}

/* 加载提示 */
.loading-tip {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #A0A0A0;
}
