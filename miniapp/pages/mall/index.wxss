.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* ===================== 顶部配额卡片 ===================== */
.quota-card {
  position: relative;
  padding: 40rpx 24rpx 32rpx;
  background: linear-gradient(135deg, #4080ff 0%, #609cff 100%);
  overflow: hidden;
}

.quota-main {
  margin-top: 20rpx;
}

.quota-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.quota-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quota-value {
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
}

.quota-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.quota-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 右上角兑换记录按钮 */
.record-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 10rpx 24rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 28rpx;
}

.record-btn:active {
  background: rgba(255, 255, 255, 0.4);
}

.record-btn-text {
  font-size: 24rpx;
  color: #ffffff;
}

/* ===================== 商品列表区 ===================== */
.section-title {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 12rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.title-count {
  font-size: 24rpx;
  color: #999999;
  margin-left: 12rpx;
}

/* ===================== 商品网格 ===================== */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 16rpx;
  box-sizing: border-box;
}

.product-card {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  background: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
}

.product-image-wrap {
  position: relative;
  width: 100%;
  /* 正方形：宽高 1:1，借助 padding-bottom 实现 */
  padding-bottom: 100%;
  height: 0;
  background: #f0f0f0;
  overflow: hidden;
}

.product-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.product-image-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f5f7fa;
}

.placeholder-icon {
  font-size: 64rpx;
  color: #c0c4cc;
}

.placeholder-text {
  font-size: 22rpx;
  color: #c0c4cc;
  margin-top: 8rpx;
}

.stock-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.product-info {
  padding: 16rpx 20rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.required-count {
  display: flex;
  align-items: baseline;
}

.required-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #f56c6c;
}

.required-unit {
  font-size: 22rpx;
  color: #f56c6c;
  margin-left: 2rpx;
}

.exchange-btn {
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #4080ff 0%, #609cff 100%);
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 28rpx;
  line-height: 1.2;
}

.exchange-btn:active {
  opacity: 0.85;
}

.exchange-btn-disabled {
  background: #d8d8d8;
  color: #ffffff;
  pointer-events: none;
}

/* ===================== 加载与空状态 ===================== */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 80rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: #c0c4cc;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  margin-top: 20rpx;
}

.empty-btn {
  margin-top: 30rpx;
  padding: 16rpx 48rpx;
  background: #f0f5ff;
  color: #4080ff;
  font-size: 26rpx;
  border-radius: 32rpx;
}

.empty-btn:active {
  opacity: 0.85;
}
